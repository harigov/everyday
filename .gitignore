/target
**/node_modules
/ui/dist
# Vite's dependency-optimiser cache. Written at the repo root because the test
# scripts start a server whose root is `ui/`, and committed once by accident.
/.vite
# Tauri's generated schemas are rebuilt on every build. The Android project
# beside them is committed: its manifest and activity are ours to edit, and
# its own .gitignore keeps the build output out. See docs/mobile.md.
/crates/karmayoga-app/gen/schemas
*.log
.DS_Store
